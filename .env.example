# Local development

1. Copy .env.example to .env and set DATABASE_URL and WEBHOOK_SECRET
2. npm install
3. npx prisma migrate dev --name init
4. npm run dev

.env.example:

DATABASE_URL=postgres://user:password@localhost:5432/lemonflip
WEBHOOK_SECRET=replace_with_a_long_secret
NEXT_PUBLIC_BRAND_COLOR=#FFD54A
